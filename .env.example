# --- Blink (joinblink.com) App Identity ---
# Blink Admin portal > Manage Apps > Created Apps > (your App Identity).
# Leave BLINK_CLIENT_SECRET empty to run in MOCK mode (messages only show in the web UI simulator).

# App Identity ID / Client ID (starts with aid-)
BLINK_CLIENT_ID=
# Client Secret shown when the App Identity was created
BLINK_CLIENT_SECRET=
# Webhook signing secret from the same App Identity screen
BLINK_WEBHOOK_SECRET=
# Optional organisation id (o-...); read from the access token if blank
BLINK_ORG_ID=
# Optional: token from a Blink *Legacy App* - only needed if automatic Blink-ID lookup by email says 'not permitted'
BLINK_LEGACY_TOKEN=

# --- Google sign-in (only @ALLOWED_EMAIL_DOMAIN accounts) ---
# Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Web application).
# Authorized redirect URI: <PUBLIC_URL>/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ALLOWED_EMAIL_DOMAIN=foresitecre.com
# Public https address of the app, e.g. https://tasks-production.up.railway.app
PUBLIC_URL=
# Long random string used to sign login cookies (keep it stable so people stay signed in)
SESSION_SECRET=

# --- Optional: plain-English status updates via Claude ---
ANTHROPIC_API_KEY=

# --- Scheduling ---
# Local hour after which daily reminders go out
REMINDER_HOUR=9
REMINDER_LOOKAHEAD_DAYS=2
DB_PATH=tasks.db
