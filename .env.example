# --- Blink (joinblink.com) ---
# Leave BLINK_API_TOKEN empty to run in MOCK mode (messages go to the "Blink outbox" in the web UI).
BLINK_API_TOKEN=
# Your Blink app / integration ID (aid-...). Sent as the app identity on outbound messages.
BLINK_APP_ID=
BLINK_API_BASE=https://api.joinblink.com/v2
# Path used to DM a user from your Blink app identity. Confirm against developer.joinblink.com.
BLINK_SEND_MESSAGE_PATH=/chats/messages
# Shared secret Blink (or your relay) sends in the X-Webhook-Secret header on inbound messages.
BLINK_WEBHOOK_SECRET=change-me

# --- Optional: natural-language status updates via Claude ---
ANTHROPIC_API_KEY=

# --- Scheduling ---
REMINDER_HOUR=9          # local hour to send daily reminders
REMINDER_LOOKAHEAD_DAYS=2
DB_PATH=tasks.db
