# --- Blink (joinblink.com) App Identity ---
# Blink Admin portal > Manage Apps > Created Apps > (your App Identity).
# Leave BLINK_CLIENT_SECRET empty to run in MOCK mode (messages only show in the web UI simulator).

# App Identity ID / Client ID (starts with aid-)
BLINK_CLIENT_ID=
# Client Secret shown when the App Identity was created
BLINK_CLIENT_SECRET=
# Webhook signing secret from the same App Identity screen
BLINK_WEBHOOK_SECRET=
# Optional organisation id (o-...); read from the access token if blank
BLINK_ORG_ID=

# --- Optional: plain-English status updates via Claude ---
ANTHROPIC_API_KEY=

# --- Scheduling ---
# Local hour after which daily reminders go out
REMINDER_HOUR=9
REMINDER_LOOKAHEAD_DAYS=2
DB_PATH=tasks.db
